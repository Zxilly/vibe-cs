{
  "name": "@vibe-cs/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm i18n:compile && tsc -b && vite build",
    "preview": "vite preview",
