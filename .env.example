# Export these values in the shell or process manager that launches the service.
# The Rust binaries do not load a repository-root .env file automatically.

# The HTTP service intentionally defaults to loopback only.
VIBE_CS_BIND=127.0.0.1:47831

# Leave empty to use the operating system's per-user application data folder.
VIBE_CS_DATA_DIR=

# Optional production path. The web bundle is normally embedded by the desktop build.
VIBE_CS_WEB_DIST=

# The worker is auto-discovered next to the host executable.
# VIBE_CS_DEMO_WORKER=C:\path\to\vibe-cs-demo-worker.exe

# One-time import into an uninitialized target. The source must be an absolute data directory.
# VIBE_CS_PREVIOUS_DATA_DIR=C:\path\to\previous-data

# Structured runtime logging filter.
RUST_LOG=info

# Put this value in apps/web/.env when overriding the Vite development client.
VITE_API_URL=/api/v1
