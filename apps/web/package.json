    "@lingui/react": "^6.10.1",
    "@tanstack/react-query": "^5.104.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flexlayout-react": "0.11.1",
    "lucide-react": "^1.61.0",
